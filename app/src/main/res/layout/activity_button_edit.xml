<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="버튼 설정"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 이미지 선택 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="아이콘 이미지"
            android:textColor="@color/text_accent_blue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/ic_button_placeholder"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="이미지를 탭하여 갤러리에서 선택"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- 연결 방식 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="연결 방식"
            android:textColor="@color/text_accent_blue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbWeb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="웹 열기"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rbApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="앱 실행"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

        </RadioGroup>

        <!-- 목적지 입력 -->
        <TextView
            android:id="@+id/tvTargetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="URL"
            android:textColor="@color/text_accent_blue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickInstalledApp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_neutral"
            android:text="설치된 앱에서 선택"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:background="@color/bg_row"
            android:hint="https://example.com"
            android:inputType="textUri"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_section_label"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_button_primary"
            android:text="저장"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_neutral_dark"
            android:text="취소"
            android:textColor="@color/text_hint"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
