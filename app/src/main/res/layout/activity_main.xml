<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnLeft"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="0dp"
        android:background="@android:color/transparent"
        android:padding="0dp"></Button>

    <Button
        android:id="@+id/btnRight"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="right"
        android:layout_margin="0dp"
        android:background="@android:color/transparent"
        android:padding="0dp"></Button>

    <Button
        android:id="@+id/btnCenter"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin="0dp"
        android:background="@android:color/transparent"
        android:padding="0dp"></Button>

    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_0" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_1" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_2" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_3" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_4" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_5" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_6" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_7" />


        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_8" />

    </ViewFlipper>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:adjustViewBounds="true"
            android:scaleType="center"
            app:srcCompat="@drawable/samsungbarun" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <ImageView
                android:id="@+id/imageButton1"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_marginHorizontal="60dp"
                android:adjustViewBounds="true"
                android:elevation="20dp"
                android:scaleType="centerCrop"
                android:layout_margin="20dp"
                app:srcCompat="@drawable/youtube" />

            <ImageView
                android:id="@+id/imageButton2"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_marginHorizontal="60dp"
                android:adjustViewBounds="true"
                android:elevation="20dp"
                android:scaleType="centerCrop"
                android:layout_margin="20dp"
                app:srcCompat="@drawable/wavve_tv" />

            <ImageView
                android:id="@+id/imageButton3"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_marginHorizontal="60dp"
                android:adjustViewBounds="true"
                android:elevation="20dp"
                android:scaleType="centerCrop"
                android:layout_margin="20dp"
                app:srcCompat="@drawable/home" />

            <ImageView
                android:id="@+id/imageButton4"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_marginHorizontal="60dp"
                android:adjustViewBounds="true"
                android:elevation="20dp"
                android:scaleType="centerCrop"
                android:layout_margin="20dp"
                app:srcCompat="@drawable/www" />

            <ImageView
                android:id="@+id/imageButton5"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_marginHorizontal="60dp"
                android:adjustViewBounds="true"
                android:elevation="20dp"
                android:scaleType="centerCrop"
                android:layout_margin="20dp"
                app:srcCompat="@drawable/blog" />

            <ImageView
                android:id="@+id/imageButton6"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_marginHorizontal="60dp"
                android:adjustViewBounds="true"
                android:elevation="20dp"
                android:scaleType="centerCrop"
                android:layout_margin="20dp"
                app:srcCompat="@drawable/medical_cerificate" />

        </LinearLayout>

        <!-- 벨 버튼: 아이콘 6개 아래 중앙 -->
        <ImageView
            android:id="@+id/bellButton"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="20dp"
            android:elevation="20dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/nurse_call" />

    </LinearLayout>
</FrameLayout>