<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      기존엔 Android Studio 기본 템플릿 색(purple_500/teal_200)이 그대로 남아있었음 — 화면 자체는
      전부 커스텀 코드로 짙은 남색/골드 팔레트를 직접 그리니 눈에 안 띄었지만, AlertDialog(비밀번호
      확인, IP 추가, 삭제 확인 등 앱 전체에서 씀)는 커스텀 스타일을 안 주기 때문에 이 테마를 그대로
      물려받아 밝은 배경 + 보라색 버튼으로 렌더링되고 있었다 — 나머지 짙은 화면과 부딪히는 유일한
      지점. 앱 실제 팔레트(파랑/골드)로 바꾸고 다크 베이스로 전환해 다이얼로그도 나머지 화면과
      맞춘다.
    -->
    <style name="Theme.Samsungbarunhospital" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/action_primary</item>
        <item name="colorPrimaryVariant">@color/bg_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/text_accent_gold</item>
        <item name="colorSecondary">@color/text_accent_gold</item>
        <item name="colorSecondaryVariant">@color/action_primary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- 한글 가독성용 Pretendard. 코드에서 동적으로 만드는 TextView/Button/다이얼로그도 테마를
             따라가도록 테마 레벨에 지정(android:는 API26+, 접두사 없는 쪽은 AppCompat용). -->
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>